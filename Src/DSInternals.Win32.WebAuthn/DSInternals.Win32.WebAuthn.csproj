<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>DSInternals.Win32.WebAuthn</AssemblyName>
    <RootNamespace>DSInternals.Win32.WebAuthn</RootNamespace>
    <TargetFrameworks>net10.0-windows;net8.0-windows;net48</TargetFrameworks>
    <PackageId>DSInternals.Win32.WebAuthn</PackageId>
    <Product>WebAuthn Interop Assembly</Product>
    <Title>WebAuthn Interop Assembly</Title>
    <Version>3.4.0</Version>
    <AssemblyVersion>3.4.0</AssemblyVersion>
    <ProductVersion>3.4.0</ProductVersion>
    <FileVersion>3.4.0</FileVersion>
    <Description>FIDO2 / W3C Web Authentication .NET Library for Windows Desktop and CLI Applications</Description>
    <PackageReleaseNotes>- BREAKING CHANGE: The `DSInternals.Win32.WebAuthn.Entra` namespace (the `MicrosoftGraphWebauthnCredentialCreationOptions`, `MicrosoftGraphWebauthnAttestationResponse`, and `MicrosoftGraphAttestationPublicKeyCredential` classes) has been removed. Microsoft Graph payloads are now represented by the data model classes from the Microsoft Graph SDK.
- BREAKING CHANGE: The synchronous `LoadFromFile` methods of the `BitwardenCleartextVaultExport`, `BitwardenEncryptedVaultExport`, `CredentialExchangeFile`, and `KeePassXCPasskey` classes have been replaced by asynchronous `LoadFromFileAsync` methods, which stream-deserialize the JSON files and support cancellation.
- Added the `BitwardenVaultExportHeader` class for detecting whether a Bitwarden vault export is encrypted and/or password-protected without parsing the entire file.
- The `WindowsHelloForBusinessSigner.ListCngKeys` method now accepts an optional `machineKeys` parameter to enumerate machine keys instead of user keys.
</PackageReleaseNotes>
    <!-- The DLL is publishable as part of the PowerShell module -->
    <IsPublishable>true</IsPublishable>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' AND '$(Configuration)' == 'Release'">
    <!-- Enable Source Link on CI builds -->
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <!-- DLLs need to be digitally signed first before a NuGet package is created. -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" />
    <PackageReference Include="Microsoft.Windows.CsWin32">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Formats.Asn1" />
    <PackageReference Include="System.Formats.Cbor" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- Classes from these namespaces are part of .NET Framework -->
    <PackageReference Include="System.Diagnostics.EventLog" />
    <PackageReference Include="System.Security.Cryptography.Cng" />
    <!-- NSec.Cryptography is not compiled for .NET Framework -->
    <PackageReference Include="NSec.Cryptography" />
  </ItemGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true' AND '$(Configuration)' == 'Release'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <!-- Enable the test assembly to access internal members. -->
  <ItemGroup Condition="$(SignAssembly) == 'true'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests, PublicKey=$(StrongNamePublicKey)</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup Condition="$(SignAssembly) != 'true'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>$(AssemblyName).Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
