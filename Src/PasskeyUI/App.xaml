<prism:PrismApplication x:Class="DSInternals.Win32.WebAuthn.PasskeyUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DSInternals.Win32.WebAuthn.PasskeyUI"
             xmlns:prism="http://prismlibrary.com/"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent theme must be loaded first -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
                <!-- Custom styles that extend Fluent theme -->
                <ResourceDictionary>
                    <!-- Shared converters -->
                    <local:ByteArrayToBase64UrlConverter x:Key="ByteArrayToBase64UrlConverter" />
                    <local:EnumAdapter x:Key="EnumAdapter" />
                    <local:GuidConverter x:Key="GuidConverter" />

                    <!-- Shared font for Fluent icons -->
                    <FontFamily x:Key="FluentIcons">Segoe Fluent Icons</FontFamily>

                    <ControlTemplate x:Key="FieldValidationErrorTemplate">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource SystemFillColorCriticalBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <AdornedElementPlaceholder x:Name="Field" />
                            </Border>
                            <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,2,0,0"
                                       Text="{Binding AdornedElement.(Validation.Errors)[0].ErrorContent, ElementName=Field}" />
                        </StackPanel>
                    </ControlTemplate>
                    <Style x:Key="PinInputStyle" TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}">
                        <!-- PasswordBox has no bindable password; validate a nonsecret self-binding instead. -->
                        <Setter Property="Tag" Value="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}" />
                        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldValidationErrorTemplate}" />
                    </Style>

                    <Style x:Key="PinFeedbackStyle" TargetType="TextBlock">
                        <!-- Without a rejected PIN, show the reported count in the normal theme color. -->
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Text" Value="{Binding RemainingAttempts, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Remaining PIN attempts: {0}.'}" />
                        <Style.Triggers>
                            <!-- Hide feedback when neither a retry count nor a PIN error is available. -->
                            <DataTrigger Binding="{Binding RemainingAttempts, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <!-- A rejected PIN overrides the hidden state and shows an error with the count. -->
                            <DataTrigger Binding="{Binding IncorrectPin, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Setter Property="Text" Value="{Binding RemainingAttempts, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='The PIN was incorrect. Remaining PIN attempts: {0}.'}" />
                            </DataTrigger>
                            <!-- When the rejected PIN has no reported count, show only the error sentence. -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IncorrectPin, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                    <Condition Binding="{Binding RemainingAttempts, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Text" Value="The PIN was incorrect." />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Common control margins -->
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Margin" Value="5,2,5,2"/>
                    </Style>
                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="Margin" Value="5,2,5,2"/>
                    </Style>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                        <Setter Property="Margin" Value="5,2,5,2"/>
                    </Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="Margin" Value="5,2,5,2"/>
                    </Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Margin" Value="5,2,5,2"/>
                    </Style>
                    <Style TargetType="GroupBox" BasedOn="{StaticResource {x:Type GroupBox}}">
                        <Setter Property="Margin" Value="5,0,5,0"/>
                    </Style>

                    <!-- Shared style for action buttons in DataGrid rows -->
                    <Style x:Key="ActionButtonStyle" TargetType="Button">
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Margin" Value="2,0" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Shared style for overlay copy buttons in DataGrid cells -->
                    <Style x:Key="OverlayCopyButtonStyle" TargetType="Button">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Setter Property="VerticalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                        <Setter Property="Margin" Value="2,0" />
                        <Setter Property="Padding" Value="6,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridCell}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                                <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- Shared style for TextBlock in DataGrid text columns -->
                    <Style x:Key="DataGridTextElementStyle" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>

                    <!-- DataGrid row style - disable selection highlighting -->
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>

                    <!-- DataGrid cell style - disable selection and focus highlighting -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
