<Window x:Class="DSInternals.Win32.WebAuthn.PasskeyUI.PinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24" Width="360">
        <TextBlock Text="&#xEF3E;" FontFamily="{StaticResource FluentIcons}" FontSize="48"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />
        <Label Content="_PIN:" Target="{Binding ElementName=PinBox}" />
        <PasswordBox x:Name="PinBox" PasswordChanged="OnPasswordChanged" Margin="0,0,0,12" />
        <TextBlock x:Name="PinFeedbackText" Style="{StaticResource PinFeedbackStyle}" TextWrapping="Wrap" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="AcceptButton" Content="OK" IsDefault="True" IsEnabled="False" MinWidth="80" Click="OnAccept" />
            <Button Content="Cancel" IsCancel="True" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
